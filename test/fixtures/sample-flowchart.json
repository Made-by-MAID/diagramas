{
  "version": 1,
  "type": "flowchart",
  "title": "Store order flow",
  "direction": "down",
  "theme": { "extends": "personal", "colors": { "accent": "#D9480F" } },
  "nodes": [
    { "id": "start", "label": "Start the order", "shape": "terminal" },
    { "id": "catalog", "label": "Catalog and prices", "shape": "data" },
    { "id": "load", "label": "Load the catalog", "shape": "process" },
    { "id": "order", "label": "Order received?", "shape": "decision" },
    { "id": "wait", "label": "Wait for the next order", "shape": "process" },
    { "id": "customer", "label": "Customer details", "shape": "io" },
    { "id": "check", "label": "Check the details", "shape": "process" },
    { "id": "stock", "label": "Is stock available?", "shape": "decision" },
    { "id": "notify", "label": "Report the missing stock", "shape": "process" },
    { "id": "reserve", "label": "Reserve the items", "shape": "process" },
    { "id": "history", "label": "Purchase history", "shape": "data" },
    { "id": "shipping", "label": "Calculate shipping", "shape": "process" },
    { "id": "coupon", "label": "Has a discount coupon?", "shape": "decision" },
    { "id": "discount", "label": "Apply the discount", "shape": "process" },
    { "id": "amount", "label": "Discounted amount", "shape": "io" },
    { "id": "charge", "label": "Issue the charge", "shape": "process" },
    { "id": "payment", "label": "Payment approved?", "shape": "decision" },
    { "id": "confirm", "label": "Send the confirmation", "shape": "io" },
    { "id": "save", "label": "Save the order", "shape": "data" },
    { "id": "end", "label": "Close for the day", "shape": "terminal" }
  ],
  "edges": [
    { "id": "e01", "from": "start", "to": "load" },
    { "id": "e02", "from": "catalog", "to": "load" },
    { "id": "e03", "from": "load", "to": "order" },
    { "id": "e04", "from": "order", "to": "customer", "label": "yes" },
    { "id": "e05", "from": "order", "to": "wait", "label": "no" },
    { "id": "e06", "from": "wait", "to": "order" },
    { "id": "e07", "from": "customer", "to": "check" },
    { "id": "e08", "from": "check", "to": "stock" },
    { "id": "e09", "from": "stock", "to": "reserve", "label": "yes" },
    { "id": "e10", "from": "stock", "to": "notify", "label": "no" },
    { "id": "e11", "from": "notify", "to": "confirm" },
    { "id": "e12", "from": "history", "to": "reserve" },
    { "id": "e13", "from": "reserve", "to": "shipping" },
    { "id": "e14", "from": "shipping", "to": "coupon" },
    { "id": "e15", "from": "coupon", "to": "discount", "label": "yes" },
    { "id": "e16", "from": "discount", "to": "amount" },
    { "id": "e17", "from": "amount", "to": "shipping" },
    { "id": "e18", "from": "coupon", "to": "charge", "label": "no" },
    { "id": "e19", "from": "charge", "to": "payment" },
    { "id": "e20", "from": "payment", "to": "confirm", "label": "yes" },
    {
      "id": "e21",
      "from": "payment",
      "to": "shipping",
      "label": "no",
      "style": { "line": "dashed" }
    },
    { "id": "e22", "from": "confirm", "to": "save" },
    { "id": "e23", "from": "save", "to": "order" },
    { "id": "e24", "from": "wait", "to": "end", "label": "end of the day" }
  ],
  "animation": {
    "durationMs": 4000,
    "fps": 20,
    "loop": true,
    "edges": [
      { "edgeId": "e04", "effect": "dash" },
      { "edgeId": "e13", "effect": "dash" },
      { "edgeId": "e17", "effect": "packet" },
      { "edgeId": "e23", "effect": "packet" },
      { "edgeId": "e21", "effect": "dash" }
    ],
    "nodes": [{ "nodeId": "order", "effect": "pulse" }, { "nodeId": "shipping", "effect": "pulse" }]
  }
}
